+    let w = sekirei_core::nnue::read_weights(weights_path)?;
+    let l1_upper = trainer::bounded_material_aux_l1_upper(&w.out);
+    let cp_upper = trainer::bounded_material_aux_cp_upper(&w.out);
+    assert!(cp_upper <= 99.0, "saved f32 auxiliary budget exceeded");
+    Ok(serde_json::json!({
+        "mode": "bounded-material-v1", "mask_version": 1,
+        "fixed_ft": "all", "fixed_l2_columns": [0,1,2,3],
+        "fixed_l2_rows": [0,1,256,257], "fixed_bias_out": [0,1,2,3],
+        "fixed_out_bias": "+0", "auxiliary_units": 28,
+        "residual_budget_cp": 99, "saved_f32_l1_upper": l1_upper,
+        "saved_f32_budget_cp_upper": cp_upper,
+        "shrink": "uniform-aux-out-f32-margin-2^-20-max8",
+        "shrink_moments": false, "optimizer": "fresh-adam",
+        "resume_supported": false, "init_seed": 42,
+        "initial_weights_fnv": "5ae69099a8bbcdad",
+        "loaded_initial_binding": "core-save-weights-exact-bytes", "label_depth": 0,
+        "target": "original-absolute-external-cp", "teacher_identity": teacher_identity,
+        "integer_core_bound_proven": false
+    }))
+}
