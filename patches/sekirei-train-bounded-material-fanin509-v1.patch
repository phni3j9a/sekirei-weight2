+    #[test]
+    fn bounded_adam_skips_protected_params_and_nonzero_moments() {
+        let mut t = bounded_synthetic_trainer();
+        // Low-level skip semantics must remain true even for stale nonzero
+        // moments. Such state is rejected by the fresh/save guards separately.
+        t.weights.ft_m.fill(0.125);
+        t.weights.ft_v.fill(0.25);
+        t.weights.bias_m.fill(0.125);
+        t.weights.bias_v.fill(0.25);
+        for row in 0..2 * L1 {
+            for col in 0..L2 {
+                if !bounded_l2_mutable(row, col) {
+                    let i = row * L2 + col;
+                    t.weights.l2_m[i] = 0.125;
+                    t.weights.l2_v[i] = 0.25;
+                }
+            }
+        }
+        for i in 0..4 {
+            t.weights.l2bias_m[i] = 0.125;
+            t.weights.l2bias_v[i] = 0.25;
+            t.weights.out_m[i] = 0.125;
+            t.weights.out_v[i] = 0.25;
+        }
+        t.weights.obias_m = 0.125;
+        t.weights.obias_v = 0.25;
+        let before = bounded_protected_bits(&t.weights);
+        let aux_before = t.weights.l2[2 * L2 + 4];
+        t.apply_bounded_material_adam(
+            &mut vec![1.0; 2 * L1 * L2],
+            &mut vec![1.0; L2],
+            &mut vec![1.0; L2],
+            0.001,
+            1,
+        );
+        assert_eq!(bounded_protected_bits(&t.weights), before);
+        assert_ne!(t.weights.l2[2 * L2 + 4].to_bits(), aux_before.to_bits());
+        assert!(t.weights.out_m[4] != 0.0 && t.weights.out_v[4] != 0.0);
+    }
