+    #[test]
+    fn bounded_uniform_shrink_checks_saved_f32_endpoints_and_keeps_moments() {
+        let mut t = bounded_synthetic_trainer();
+        let material = t.weights.out[..4].to_vec();
+        let mut tiny = vec![0.0; L2];
+        tiny[4] = f32::from_bits(1);
+        assert!(bounded_material_aux_l1_upper(&tiny) >= f64::from_bits((1023u64 - 149) << 52));
+        let zero = t.weights.out.clone();
+        bounded_shrink_aux_out(&mut t.weights.out);
+        assert_eq!(t.weights.out, zero);
+        t.weights.out[4] = 1.0;
+        let under = t.weights.out.clone();
+        bounded_shrink_aux_out(&mut t.weights.out);
+        assert_eq!(t.weights.out, under);
+        let edge = (99.0f64 * 64.0 / 127.0) as f32;
+        t.weights.out[4] = f32::from_bits(edge.to_bits() + 1);
+        assert!(bounded_material_aux_l1_upper(&t.weights.out) * 127.0 / 64.0 > 99.0);
+        t.weights.out_m[4] = 0.125;
+        t.weights.out_v[4] = 0.25;
+        let before_m = t.weights.out_m.clone();
+        let before_v = t.weights.out_v.clone();
+        bounded_shrink_aux_out(&mut t.weights.out);
+        assert!(bounded_material_aux_l1_upper(&t.weights.out) * 127.0 / 64.0 <= 99.0);
+        assert_eq!(t.weights.out_m, before_m);
+        assert_eq!(t.weights.out_v, before_v);
+        t.weights.out[4..].fill(100.0);
+        t.weights.out[5] = -200.0;
+        bounded_shrink_aux_out(&mut t.weights.out);
+        assert!(bounded_material_aux_l1_upper(&t.weights.out) * 127.0 / 64.0 <= 99.0);
+        assert!((t.weights.out[5] + 2.0 * t.weights.out[4]).abs() <= 1e-6);
+        assert_eq!(t.weights.out[..4], material);
+    }
