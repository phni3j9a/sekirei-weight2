+    #[test]
+    fn bounded_auxiliary_output_then_l2_receives_gradient() {
+        let mut t = bounded_synthetic_trainer();
+        let board = Board::startpos();
+        let initial = t.weights.clone();
+        t.train_position(&board, 500.0, 1.0, 500.0, None, 0, GameResult::Unknown);
+        assert_eq!(t.weights.step, 1);
+        assert_eq!(t.weights.l2, initial.l2);
+        assert!(t.weights.out[4..].iter().any(|x| *x != 0.0));
+        t.train_position(&board, 500.0, 1.0, 500.0, None, 0, GameResult::Unknown);
+        assert_eq!(t.weights.step, 2);
+        assert_ne!(t.weights.l2, initial.l2);
+        assert_eq!(
+            bounded_protected_bits(&t.weights),
+            bounded_protected_bits(&initial)
+        );
+        t.assert_bounded_material_v1();
+    }
