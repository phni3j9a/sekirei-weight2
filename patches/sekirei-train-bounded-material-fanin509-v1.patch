+    fn bounded_synthetic_trainer() -> Trainer {
+        let mut trainer = Trainer::new(42, 0.5);
+        let w = &mut trainer.weights;
+        w.ft.fill(1.0 / 64.0);
+        w.ft_bias.fill(1.0);
+        w.l2.fill(0.0);
+        for (row, col) in [(0, 0), (1, 1), (256, 2), (257, 3)] {
+            w.l2[row * L2 + col] = 1.0;
+        }
+        for row in 0..2 * L1 {
+            for col in 4..L2 {
+                if bounded_l2_mutable(row, col) {
+                    w.l2[row * L2 + col] = 1.0 / 256.0;
+                }
+            }
+        }
+        w.l2_bias.fill(4.0);
+        w.l2_bias[..4].fill(0.0);
+        w.out.fill(0.0);
+        w.out[..4].copy_from_slice(&[8192.0, 8192.0, -8192.0, -8192.0]);
+        trainer.teacher_score_cap = 30000.0;
+        trainer.enable_bounded_material_v1();
+        trainer
+    }
+
+    fn bounded_protected_bits(w: &TrainWeights) -> Vec<u32> {
+        let mut bits: Vec<u32> =
+            w.ft.iter()
+                .chain(&w.ft_bias)
+                .chain(&w.ft_m)
+                .chain(&w.ft_v)
+                .chain(&w.bias_m)
+                .chain(&w.bias_v)
+                .map(|x| x.to_bits())
+                .collect();
+        for row in 0..2 * L1 {
+            for col in 0..L2 {
+                if !bounded_l2_mutable(row, col) {
+                    let i = row * L2 + col;
+                    bits.extend([w.l2[i].to_bits(), w.l2_m[i].to_bits(), w.l2_v[i].to_bits()]);
+                }
+            }
+        }
+        for i in 0..4 {
+            for value in [
+                w.l2_bias[i],
+                w.l2bias_m[i],
+                w.l2bias_v[i],
+                w.out[i],
+                w.out_m[i],
+                w.out_v[i],
+            ] {
+                bits.push(value.to_bits());
+            }
+        }
+        bits.extend([
+            w.out_bias.to_bits(),
+            w.obias_m.to_bits(),
+            w.obias_v.to_bits(),
+        ]);
+        bits
+    }
