+fn save_bounded_output_metadata(output: &Path, teacher_identity: &str) -> io::Result<()> {
+    let path = output.with_extension("meta.json");
+    let mut meta: serde_json::Value =
+        serde_json::from_slice(&fs::read(&path)?).map_err(io::Error::other)?;
+    meta["bounded_material_v1"] = bounded_material_metadata(output, teacher_identity)?;
+    write_atomic(
+        &path,
+        &serde_json::to_vec_pretty(&meta).map_err(io::Error::other)?,
+    )
+}
+
+fn bounded_material_fanin509_metadata(
+    weights_path: &Path,
+    teacher_identity: &str,
+) -> io::Result<serde_json::Value> {
+    let mut meta = bounded_material_metadata(weights_path, teacher_identity)?;
+    let mode = BoundedMaterialMode::Fanin509V1;
+    meta["mode"] = serde_json::json!(mode.name());
+    meta["l2_effective_lr_denominator"] = serde_json::json!(mode.l2_effective_lr_denominator());
+    meta["out_effective_lr_denominator"] = serde_json::json!(mode.out_effective_lr_denominator());
