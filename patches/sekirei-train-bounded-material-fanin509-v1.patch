+    #[test]
+    fn bounded_guards_reject_nonfinite_stale_and_changed_fixed_state() {
+        for invalid in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+            let mut out = vec![0.0; L2];
+            out[4] = invalid;
+            assert!(
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bounded_shrink_aux_out(
+                    &mut out
+                )))
+                .is_err()
+            );
+        }
+        let mut stale = bounded_synthetic_trainer();
+        stale.bounded_material_v1 = None;
+        stale.weights.out_m[4] = 0.1;
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || stale.enable_bounded_material_v1()
+            ))
+            .is_err()
+        );
+        let mut stepped = bounded_synthetic_trainer();
+        stepped.bounded_material_v1 = None;
+        stepped.weights.step = 1;
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || stepped.enable_bounded_material_v1()
+            ))
+            .is_err()
+        );
+        let mut changed = bounded_synthetic_trainer();
+        changed.weights.ft[17] += 1.0 / 64.0;
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || changed.assert_bounded_material_v1()
+            ))
+            .is_err()
+        );
+        let mut fixed_row = bounded_synthetic_trainer();
+        fixed_row.weights.l2[4] = 0.1;
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || fixed_row.assert_bounded_material_v1()
+            ))
+            .is_err()
+        );
+    }
