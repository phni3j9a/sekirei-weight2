+/// Closed, fixed optimizer contracts. No caller-supplied denominator exists.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BoundedMaterialMode {
+    V1,
+    Fanin509V1,
+}
+
+impl BoundedMaterialMode {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::V1 => "bounded-material-v1",
+            Self::Fanin509V1 => "bounded-material-fanin509-v1",
+        }
+    }
+
+    pub fn metadata_key(self) -> &'static str {
+        match self {
+            Self::V1 => "bounded_material_v1",
+            Self::Fanin509V1 => "bounded_material_fanin509_v1",
+        }
+    }
+
+    pub fn l2_effective_lr_denominator(self) -> u32 {
+        match self {
+            Self::V1 => 1,
+            Self::Fanin509V1 => 509,
+        }
+    }
+
+    pub fn out_effective_lr_denominator(self) -> u32 {
+        1
+    }
+
+    fn l2_effective_lr(self, epoch_lr: f32) -> f32 {
+        // Preserve the legacy f32 operand unchanged; only the new mode divides.
+        let lr = match self {
+            Self::V1 => epoch_lr,
+            Self::Fanin509V1 => epoch_lr / 509.0_f32,
+        };
+        assert!(lr.is_finite() && lr > 0.0, "invalid bounded L2 effective LR");
+        lr
+    }
+}
+
+struct BoundedMaterialReference {
+    mode: BoundedMaterialMode,
+    ft: Vec<f32>,
+    ft_bias: Vec<f32>,
+}
