+        assert_eq!(trainer.weights.step, 2);
+        assert_eq!(bounded_protected_bits(&trainer.weights), fixed);
+        trainer.assert_bounded_material_v1();
+        let directory = tempfile::tempdir().unwrap();
+        let native = directory.path().join("fanin509.bin");
+        sekirei_core::nnue::save_weights(&trainer.weights.to_nnue_weights(), &native).unwrap();
+        trainer.verify_bounded_saved_weights(&native);
+        let adam = directory.path().join("fanin509.adam.json");
+        trainer.weights.save_adam_checkpoint(&adam).unwrap();
+        trainer.verify_bounded_saved_adam(&adam);
+    }
