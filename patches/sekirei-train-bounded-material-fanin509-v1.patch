+struct BoundedInitialTemp(PathBuf);
+
+impl Drop for BoundedInitialTemp {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+// The core exposes save_weights(path), not a public in-memory encoder.
+// Use that exact serializer in an owned private directory, then remove it.
+fn bounded_canonical_initial_bytes(
+    weights: &sekirei_core::nnue::NnueWeights,
+    output: &Path,
+) -> Result<Vec<u8>, String> {
+    let nonce = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|error| format!("cannot name bounded initial check: {error}"))?
+        .as_nanos();
+    let parent = output
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    let directory = parent.join(format!(
+        ".bounded-initial-check-{}-{nonce}",
+        std::process::id()
+    ));
+    let mut builder = fs::DirBuilder::new();
+    #[cfg(unix)]
+    {
+        std::os::unix::fs::DirBuilderExt::mode(&mut builder, 0o700);
+    }
+    builder
+        .create(&directory)
+        .map_err(|error| format!("cannot create private initial check: {error}"))?;
+    let cleanup = BoundedInitialTemp(directory.clone());
+    let path = directory.join("loaded-canonical.bin");
+    let result = sekirei_core::nnue::save_weights(weights, &path)
+        .and_then(|()| fs::read(&path))
+        .map_err(|error| format!("cannot serialize actual loaded initial weights: {error}"));
+    let removed = fs::remove_dir_all(&directory)
+        .map_err(|error| format!("cannot clean bounded initial check: {error}"));
+    drop(cleanup);
+    let canonical = result?;
+    removed?;
+    Ok(canonical)
+}
+
+fn validate_bounded_initial_binding(
+    initial: &[u8],
+    canonical: &[u8],
+    expected_fnv: u64,
+) -> Result<(), String> {
+    if checkpoint_hash(initial) != expected_fnv
+        || checkpoint_hash(canonical) != expected_fnv
+        || canonical != initial
+    {
+        return Err("actual loaded material parameters differ from pinned initial bytes".into());
+    }
+    Ok(())
+}
