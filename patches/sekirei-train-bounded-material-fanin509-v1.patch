+fn bounded_l2_mutable(row: usize, column: usize) -> bool {
+    column >= 4 && !matches!(row, 0 | 1 | 256 | 257)
+}
+
+fn bounded_check_protected(w: &TrainWeights) {
+    assert_eq!(w.l2.len(), 2 * L1 * L2);
+    assert_eq!(w.l2_bias.len(), L2);
+    assert_eq!(w.out.len(), L2);
+    for row in 0..2 * L1 {
+        for column in 0..L2 {
+            if !bounded_l2_mutable(row, column) {
+                let expected = if matches!((row, column), (0, 0) | (1, 1) | (256, 2) | (257, 3)) {
+                    1.0f32
+                } else {
+                    0.0
+                };
+                let i = row * L2 + column;
+                assert_eq!(
+                    w.l2[i].to_bits(),
+                    expected.to_bits(),
+                    "fixed material L2 changed"
+                );
+                assert_eq!(w.l2_m[i].to_bits(), 0, "fixed material L2 moment changed");
+                assert_eq!(w.l2_v[i].to_bits(), 0, "fixed material L2 variance changed");
+            }
+        }
+    }
+    for i in 0..4 {
+        let out = if i < 2 { 8192.0f32 } else { -8192.0 };
+        assert_eq!(w.l2_bias[i].to_bits(), 0);
+        assert_eq!(w.out[i].to_bits(), out.to_bits());
+        for value in [w.l2bias_m[i], w.l2bias_v[i], w.out_m[i], w.out_v[i]] {
+            assert_eq!(
+                value.to_bits(),
+                0,
+                "fixed material bias/output moment changed"
+            );
+        }
+    }
+    for value in [w.out_bias, w.obias_m, w.obias_v] {
+        assert_eq!(value.to_bits(), 0, "fixed output bias changed");
+    }
+}
+
+/// Upper bound on the exact sum of the actual binary32 coefficients: each
+/// nonnegative f64 addition is advanced one representable value upward.
+// Decode finite binary32 bits without SSE f32->f64 conversion: inherited
+// DAZ must not erase stored subnormal coefficients from the byte budget.
+fn bounded_f32_as_f64(value: f32) -> f64 {
+    let bits = value.to_bits();
+    let exponent = (bits >> 23) & 0xff;
+    let mantissa = bits & 0x7fffff;
+    assert!(exponent != 0xff, "nonfinite auxiliary output");
+    let magnitude = if exponent == 0 {
+        mantissa as f64 * f64::from_bits((1023u64 - 149) << 52)
+    } else {
+        f64::from_bits(((exponent as u64 + 896) << 52) | ((mantissa as u64) << 29))
+    };
+    if bits >> 31 != 0 {
+        -magnitude
+    } else {
+        magnitude
+    }
+}
+
+pub fn bounded_material_aux_l1_upper(out: &[f32]) -> f64 {
+    assert_eq!(out.len(), L2);
+    let mut sum = 0.0f64;
+    for &value in &out[4..] {
+        assert!(value.is_finite(), "nonfinite auxiliary output");
+        if value.to_bits() & 0x7fffffff != 0 {
+            let added = sum + bounded_f32_as_f64(value).abs();
+            assert!(added.is_finite());
+            sum = f64::from_bits(added.to_bits() + 1);
+        }
+    }
+    sum
+}
+
+pub fn bounded_material_aux_cp_upper(out: &[f32]) -> f64 {
+    let l1_upper = bounded_material_aux_l1_upper(out);
+    if l1_upper == 0.0 {
+        return 0.0;
+    }
+    let product = l1_upper * 127.0;
+    assert!(product.is_finite());
+    // Power-of-two division is exact in this finite binary32-derived range.
+    f64::from_bits(product.to_bits() + 1) / 64.0
+}
+
+fn bounded_shrink_aux_out(out: &mut [f32]) {
+    const CAP_L1: f64 = 99.0 * 64.0 / 127.0;
+    const MARGIN: f64 = 1.0 - 1.0 / 1048576.0;
+    for _ in 0..8 {
+        let upper = bounded_material_aux_l1_upper(out);
+        if bounded_material_aux_cp_upper(out) <= 99.0 {
+            return;
+        }
+        let shrink = (CAP_L1 / upper) * MARGIN;
+        assert!(shrink.is_finite() && shrink > 0.0 && shrink < 1.0);
+        for value in &mut out[4..] {
+            *value = (bounded_f32_as_f64(*value) * shrink) as f32;
+            assert!(value.is_finite());
+        }
+    }
+    assert!(
+        bounded_material_aux_cp_upper(out) <= 99.0,
+        "f32 auxiliary contraction did not meet budget"
+    );
+}
+
+fn bounded_adam_scalar(
+    param: &mut f32,
+    m: &mut f32,
+    v: &mut f32,
+    grad: f32,
+    lr: f32,
+    t: u64,
+) -> f32 {
+    assert!(param.is_finite() && m.is_finite() && v.is_finite() && *v >= 0.0 && grad.is_finite());
+    let delta = adam_update_scalar(param, m, v, grad, lr, t);
+    assert!(
+        param.is_finite() && m.is_finite() && v.is_finite() && delta.is_finite(),
+        "nonfinite bounded Adam update"
+    );
+    delta
+}
