+fn bounded_checkpoint_native_path(metadata_path: &Path) -> io::Result<PathBuf> {
+    // Epoch metadata has two extensions; replacing only "json" would read
+    // weights.epoch1.meta.bin instead of the saved weights.epoch1.bin.
+    // Check each exact suffix and preserve parent directories/non-UTF names.
+    let without_json = metadata_path.with_extension("");
+    if metadata_path.extension() != Some(std::ffi::OsStr::new("json"))
+        || without_json.extension() != Some(std::ffi::OsStr::new("meta"))
+        || without_json
+            .file_stem()
+            .map_or(true, |stem| stem.is_empty())
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "bounded checkpoint metadata path must name *.meta.json",
+        ));
+    }
+    Ok(without_json.with_extension("bin"))
+}
