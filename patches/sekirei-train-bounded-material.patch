+    /// Cheap per-step mask is structural; this complete reference check is
+    /// performed at enable and each save, rather than scanning FT each step.
+    pub fn assert_bounded_material_v1(&self) {
+        let Some(reference) = &self.bounded_material_v1 else {
+            return;
+        };
+        self.assert_bounded_configuration();
+        assert_eq!(self.weights.ft.len(), reference.ft.len());
+        assert_eq!(self.weights.ft_bias.len(), reference.ft_bias.len());
+        for (actual, initial) in self
+            .weights
+            .ft
+            .iter()
+            .chain(&self.weights.ft_bias)
+            .zip(reference.ft.iter().chain(&reference.ft_bias))
+        {
+            assert_eq!(actual.to_bits(), initial.to_bits(), "fixed FT changed");
+        }
+        bounded_check_protected(&self.weights);
+        for value in self
+            .weights
+            .l2
+            .iter()
+            .chain(&self.weights.l2_bias)
+            .chain(&self.weights.out)
+            .chain(&self.weights.l2_m)
+            .chain(&self.weights.l2_v)
+            .chain(&self.weights.l2bias_m)
+            .chain(&self.weights.l2bias_v)
+            .chain(&self.weights.out_m)
+            .chain(&self.weights.out_v)
+        {
+            assert!(
+                value.is_finite(),
+                "bounded checkpoint contains nonfinite values"
+            );
+        }
+        for value in self
+            .weights
+            .ft_m
+            .iter()
+            .chain(&self.weights.ft_v)
+            .chain(&self.weights.bias_m)
+            .chain(&self.weights.bias_v)
+        {
+            assert_eq!(value.to_bits(), 0, "fixed FT moments changed");
+        }
+        assert!(
+            bounded_material_aux_cp_upper(&self.weights.out) <= 99.0,
+            "bounded checkpoint output budget exceeded"
+        );
+    }
