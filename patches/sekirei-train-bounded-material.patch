+    /// Raw Adam mode remains bound by external source/run metadata.
+    pub fn verify_bounded_saved_adam(&self, path: &std::path::Path) {
+        if self.bounded_material_v1.is_none() {
+            return;
+        }
+        self.assert_bounded_material_v1();
+        let actual = TrainWeights::load_adam_checkpoint(path).expect("cannot reload bounded Adam");
+        let expected = &self.weights;
+        assert_eq!(actual.step, expected.step);
+        let floats = |w: &TrainWeights| -> Vec<u32> {
+            w.ft.iter()
+                .chain(&w.ft_bias)
+                .chain(&w.l2)
+                .chain(&w.l2_bias)
+                .chain(&w.out)
+                .chain(&w.ft_m)
+                .chain(&w.ft_v)
+                .chain(&w.bias_m)
+                .chain(&w.bias_v)
+                .chain(&w.l2_m)
+                .chain(&w.l2_v)
+                .chain(&w.l2bias_m)
+                .chain(&w.l2bias_v)
+                .chain(&w.out_m)
+                .chain(&w.out_v)
+                .map(|value| value.to_bits())
+                .collect()
+        };
+        assert!(
+            floats(&actual) == floats(expected),
+            "saved Adam parameters or moments differ"
+        );
+        for (a, e) in [
+            (actual.out_bias, expected.out_bias),
+            (actual.obias_m, expected.obias_m),
+            (actual.obias_v, expected.obias_v),
+        ] {
+            assert_eq!(a.to_bits(), e.to_bits());
+        }
+    }
