+    fn apply_bounded_material_adam(
+        &mut self,
+        d_l2: &mut [f32],
+        d_l2_bias: &mut [f32],
+        d_out: &mut [f32],
+        lr: f32,
+        t: u64,
+    ) -> (f64, f64, f64) {
+        self.assert_bounded_configuration();
+        assert!(lr.is_finite() && lr > 0.0);
+        let w = &mut self.weights;
+        let mut l2_sq = 0.0;
+        for row in 0..2 * L1 {
+            for column in 0..L2 {
+                let i = row * L2 + column;
+                if bounded_l2_mutable(row, column) {
+                    let delta = bounded_adam_scalar(
+                        &mut w.l2[i],
+                        &mut w.l2_m[i],
+                        &mut w.l2_v[i],
+                        d_l2[i],
+                        lr,
+                        t,
+                    );
+                    d_l2[i] = delta;
+                    l2_sq += (delta as f64).powi(2);
+                } else {
+                    d_l2[i] = 0.0;
+                }
+            }
+        }
+        let mut bias_sq = 0.0;
+        let before_out = w.out.clone();
+        for i in 0..L2 {
+            if i >= 4 {
+                let delta = bounded_adam_scalar(
+                    &mut w.l2_bias[i],
+                    &mut w.l2bias_m[i],
+                    &mut w.l2bias_v[i],
+                    d_l2_bias[i],
+                    lr,
+                    t,
+                );
+                d_l2_bias[i] = delta;
+                bias_sq += (delta as f64).powi(2);
+                bounded_adam_scalar(
+                    &mut w.out[i],
+                    &mut w.out_m[i],
+                    &mut w.out_v[i],
+                    d_out[i],
+                    lr,
+                    t,
+                );
+            } else {
+                d_l2_bias[i] = 0.0;
+                d_out[i] = 0.0;
+            }
+        }
+        bounded_shrink_aux_out(&mut w.out);
+        let mut out_sq = 0.0;
+        for i in 4..L2 {
+            d_out[i] = w.out[i] - before_out[i];
+            out_sq += (d_out[i] as f64).powi(2);
+        }
+        (l2_sq, bias_sq, out_sq)
+    }
