+    pub fn enable_bounded_material_v1(&mut self) {
+        assert!(self.bounded_material_v1.is_none());
+        assert_eq!((INPUT, L1, L2), (2420, 256, 32));
+        self.assert_bounded_configuration();
+        assert_eq!(self.weights.step, 0, "bounded material requires fresh Adam");
+        bounded_check_protected(&self.weights);
+        for value in self.weights.ft.iter().chain(&self.weights.ft_bias) {
+            let quantized = *value * 64.0;
+            assert!(
+                value.is_finite()
+                    && quantized.fract() == 0.0
+                    && (-32767.0..=32767.0).contains(&quantized),
+                "initial FT must exactly roundtrip"
+            );
+        }
+        for value in self
+            .weights
+            .l2
+            .iter()
+            .chain(&self.weights.l2_bias)
+            .chain(&self.weights.out)
+        {
+            assert!(value.is_finite(), "nonfinite initial weights");
+        }
+        for value in self
+            .weights
+            .ft_m
+            .iter()
+            .chain(&self.weights.ft_v)
+            .chain(&self.weights.bias_m)
+            .chain(&self.weights.bias_v)
+            .chain(&self.weights.l2_m)
+            .chain(&self.weights.l2_v)
+            .chain(&self.weights.l2bias_m)
+            .chain(&self.weights.l2bias_v)
+            .chain(&self.weights.out_m)
+            .chain(&self.weights.out_v)
