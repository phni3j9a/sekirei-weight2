+    #[test]
+    fn bounded_ft_native_roundtrip_and_saved_f32_values_are_exact() {
+        let mut t = bounded_synthetic_trainer();
+        t.weights.ft[0] = -32767.0 / 64.0;
+        t.weights.ft[1] = 32767.0 / 64.0;
+        // Start a new private reference after the synthetic exact i16 setup.
+        t.bounded_material_v1 = None;
+        let native = t.weights.to_nnue_weights();
+        t.weights = TrainWeights::from_nnue_weights(&native);
+        t.enable_bounded_material_v1();
+        assert_eq!(native.ft, t.weights.to_nnue_weights().ft);
+        assert_eq!(native.ft_bias, t.weights.to_nnue_weights().ft_bias);
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("synthetic.bin");
+        sekirei_core::nnue::save_weights(&t.weights.to_nnue_weights(), &path).unwrap();
+        t.verify_bounded_saved_weights(&path);
+        let adam = directory.path().join("synthetic.adam.json");
+        t.weights.save_adam_checkpoint(&adam).unwrap();
+        t.verify_bounded_saved_adam(&adam);
