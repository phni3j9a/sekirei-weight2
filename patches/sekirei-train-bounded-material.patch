+        }
+        assert_eq!(self.weights.obias_m.to_bits(), 0);
+        assert_eq!(self.weights.obias_v.to_bits(), 0);
+        for value in &self.weights.out[4..] {
+            assert_eq!(value.to_bits(), 0, "initial auxiliary output must be +0");
+        }
+        self.bounded_material_v1 = Some(BoundedMaterialReference {
+            ft: self.weights.ft.clone(),
+            ft_bias: self.weights.ft_bias.clone(),
