+    /// Confirm native saved values (including all f32 auxiliary coordinates)
+    /// reproduce the complete in-memory export. No integer-core bound claim.
+    pub fn verify_bounded_saved_weights(&self, path: &std::path::Path) {
+        if self.bounded_material_v1.is_none() {
+            return;
+        }
+        self.assert_bounded_material_v1();
+        let expected = self.weights.to_nnue_weights();
+        let actual =
+            sekirei_core::nnue::read_weights(path).expect("cannot reload bounded native weights");
+        assert!(actual.ft == expected.ft, "saved FT differs");
+        assert!(actual.ft_bias == expected.ft_bias, "saved FT bias differs");
+        for row in 0..2 * L1 {
+            for column in 0..L2 {
+                assert_eq!(
+                    actual.l2[row][column].to_bits(),
+                    expected.l2[row][column].to_bits()
+                );
+            }
+        }
+        for i in 0..L2 {
+            assert_eq!(actual.l2_bias[i].to_bits(), expected.l2_bias[i].to_bits());
+            assert_eq!(actual.out[i].to_bits(), expected.out[i].to_bits());
+        }
+        assert_eq!(actual.out_bias.to_bits(), expected.out_bias.to_bits());
+        assert!(bounded_material_aux_cp_upper(&actual.out) <= 99.0);
+    }
