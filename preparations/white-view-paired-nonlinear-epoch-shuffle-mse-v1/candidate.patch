+// Fixed integer row-order variant. Numerical position update stays unchanged.
+const SHUFFLE_SEED:u64=20261006;
+const SHUFFLE_GAMMA:u64=0x9e3779b97f4a7c15;
+const SHUFFLE_ALGORITHM:&str="splitmix64-fisher-yates-rejection-v1";
+struct StableSplitMix64{state:u64}
+impl StableSplitMix64{
+    fn next(&mut self)->u64{
+        self.state=self.state.wrapping_add(SHUFFLE_GAMMA);
+        let mut z=self.state;
+        z=(z^(z>>30)).wrapping_mul(0xbf58476d1ce4e5b9);
+        z=(z^(z>>27)).wrapping_mul(0x94d049bb133111eb);
+        z^(z>>31)
+    }
+    fn below(&mut self,bound:u64)->Result<u64,String>{
+        if bound==0{return Err("positive shuffle bound required".into());}
+        let threshold=bound.wrapping_neg()%bound;
+        loop{let value=self.next();if value>=threshold{return Ok(value%bound);}}
+    }
+}
+pub fn shuffle_permutation(count:usize,seed:u64,epoch:u32)->Result<Vec<usize>,String>{
+    if count==0||seed!=SHUFFLE_SEED||!(1..=3).contains(&epoch){return Err("fixed shuffle seed/fresh epoch/count required".into());}
+    let mut order:Vec<usize>=(0..count).collect();
+    let mut rng=StableSplitMix64{state:seed^(epoch as u64).wrapping_mul(SHUFFLE_GAMMA)};
+    for i in (1..count).rev(){
+        let j=usize::try_from(rng.below(u64::try_from(i+1).map_err(|_|"shuffle count overflow")?)?).map_err(|_|"shuffle index overflow")?;
+        order.swap(i,j);
+    }Ok(order)
+}
+fn order_identity(order:&[usize])->Result<serde_json::Value,String>{
+    let size=order.len().checked_mul(8).ok_or("shuffle byte count overflow")?;
+    let mut raw=Vec::with_capacity(size);
+    for &i in order{raw.extend_from_slice(&u64::try_from(i).map_err(|_|"shuffle index overflow")?.to_le_bytes());}
+    Ok(serde_json::json!({"bytes":size,"sha256":crate::paired_nonlinear_sha256::hex(&raw)?}))
+}
+pub fn row_order_declaration()->serde_json::Value{
+    serde_json::json!({"algorithm":"splitmix64-fisher-yates-rejection-v1","seed_mixing":"state=seed-xor-epoch-times-0x9e3779b97f4a7c15-mod2^64;next-adds-gamma","index_encoding":"original-train-row-index-u64-le","consumption_trace":"successful-update-indices-in-contiguous-1024-row-chunks-v1","epochs":[{"epoch":1,"count":112681,"bytes":901448,"sha256":"bf2bca166952f95db75b4508360ee4cf3ea5d9507bf5cee4bc0951f8006f8551"},{"epoch":2,"count":112681,"bytes":901448,"sha256":"3920f2d9ad3f8af31cd636c84284b85200635a58795f479296a00e27267d664a"},{"epoch":3,"count":112681,"bytes":901448,"sha256":"1700b38354b9e24387d031d5174cd2c14c8e87108b23e22eebb9fd54df5525f2"}]})
+}
+struct ShuffleConsumption{
+    epoch:u32,start_step:u64,expected:Vec<usize>,consumed:Vec<usize>,seen:Vec<bool>,emit:bool,
+}
+impl ShuffleConsumption{
+    fn new(count:usize,epoch:u32,start_step:u64,order:&[usize],emit:bool)->Result<Self,String>{
+        let expected=shuffle_permutation(count,SHUFFLE_SEED,epoch)?;
+        if order!=expected.as_slice()||start_step!=(epoch as u64-1).checked_mul(count as u64).ok_or("shuffle start overflow")?{
+            return Err("fixed full permutation/start update differs".into());
+        }
+        if emit{eprintln!("PAIRED_SHUFFLE_BEGIN {}",serde_json::json!({"epoch":epoch,"seed":SHUFFLE_SEED,
+            "count":count,"algorithm":SHUFFLE_ALGORITHM,"permutation":order_identity(&expected)?}));}
+        Ok(Self{epoch,start_step,expected,consumed:Vec::with_capacity(count),seen:vec![false;count],emit})
+    }
+    // Called ONLY after actual position update succeeded, with its original
+    // train-row index and observed optimizer step; never derives used rows
+    // from a recomputed declaration at completion time.
+    fn record(&mut self,index:usize,actual_step:u64)->Result<(),String>{
+        let position=self.consumed.len();
+        if index>=self.seen.len()||self.seen[index]||self.expected.get(position)!=Some(&index)
+            ||actual_step!=self.start_step.checked_add(position as u64+1).ok_or("shuffle update overflow")?{
+            return Err("duplicate/outside/order/actual update step mismatch".into());
+        }
+        self.seen[index]=true;self.consumed.push(index);
+        if self.emit&&(self.consumed.len()%1024==0||self.consumed.len()==self.expected.len()){
+            let end=self.consumed.len();let start=((end-1)/1024)*1024;
+            eprintln!("PAIRED_SHUFFLE_ROWS {}",serde_json::json!({"epoch":self.epoch,"start_position":start,
+                "start_step":self.start_step+start as u64,"end_step":actual_step,"indices":&self.consumed[start..end]}));
+        }Ok(())
+    }
+    fn finish(&self,actual_step:u64)->Result<(),String>{
+        if self.consumed.len()!=self.expected.len()||self.seen.iter().any(|v|!*v)
+            ||actual_step!=self.start_step+self.expected.len()as u64
+            ||order_identity(&self.consumed)?!=order_identity(&self.expected)?{
+            return Err("incomplete actual row consumption/update/digest".into());
+        }
+        if self.emit{eprintln!("PAIRED_SHUFFLE_COMPLETE {}",serde_json::json!({"epoch":self.epoch,
+            "consumed_count":self.consumed.len(),"start_step":self.start_step,"end_step":actual_step,
+            "consumed":order_identity(&self.consumed)?}));}Ok(())
+    }
+}
