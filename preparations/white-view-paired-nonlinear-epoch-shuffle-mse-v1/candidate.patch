+            assert_eq!(order_identity(&order).unwrap()["sha256"],declaration["epochs"][(epoch-1)as usize]["sha256"]);
+            assert_eq!(order,shuffle_permutation(112681,SHUFFLE_SEED,epoch).unwrap());
+        }
+        assert_ne!(shuffle_permutation(112681,SHUFFLE_SEED,1).unwrap(),shuffle_permutation(112681,SHUFFLE_SEED,2).unwrap());
+    }
+    #[test] fn shuffle_rejects_seed_epoch_missing_duplicate_and_order(){
