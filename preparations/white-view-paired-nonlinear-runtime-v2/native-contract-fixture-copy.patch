 #[cfg(test)]mod tests{use super::*;
- fn paired_zero(r:&NnueWeights)->NnueWeights{let mut w=r.clone();for pair in 0..14{let p=4+2*pair;let n=p+1;for j in 2..L1{w.l2[L1+j][n]=w.l2[j][p];w.l2[j][n]=w.l2[L1+j][p];}w.l2_bias[n]=w.l2_bias[p];w.out[n]=f32::from_bits(w.out[p].to_bits()^0x8000_0000);}w}
+ fn copy_weights(r: &NnueWeights) -> NnueWeights {
+     NnueWeights {
+         ft: r.ft.clone(),
+         ft_bias: r.ft_bias,
+         l2: r.l2.clone(),
+         l2_bias: r.l2_bias,
+         out: r.out,
+         out_bias: r.out_bias,
+     }
+ }
+ fn paired_zero(r:&NnueWeights)->NnueWeights{let mut w=copy_weights(r);for pair in 0..14{let p=4+2*pair;let n=p+1;for j in 2..L1{w.l2[L1+j][n]=w.l2[j][p];w.l2[j][n]=w.l2[L1+j][p];}w.l2_bias[n]=w.l2_bias[p];w.out[n]=f32::from_bits(w.out[p].to_bits()^0x8000_0000);}w}
+
+ #[test]
