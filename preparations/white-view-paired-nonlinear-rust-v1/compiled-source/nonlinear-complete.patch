+            let mut weights = NnueWeights::default_lcg();
+            weights.ft[BOARD_INPUT + 2 * HAND_THRESHOLDS + 5][channel] ^= 1;
+            assert_eq!(
+                weights.validate_white_view_hand_ties().unwrap_err().kind(),
+                ErrorKind::InvalidData
+            );
+        }
+        let mut weights = NnueWeights::default_lcg();
+        weights.ft.pop();
