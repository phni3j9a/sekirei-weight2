+const SCHEMA:&str="sekirei.white-view-paired-nonlinear-fullstate-bits-checkpoint.v1";
+const STEPS:u64=3*112681;
+fn validate_end(w:&TrainWeights,recipe:DeclaredRecipe)->Result<(),String>{
